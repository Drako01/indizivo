{
  "name": "indizivo",
  "displayName": "Indizivo",
  "version": "0.2.1",
  "publisher": "armotusitio",
  "description": "%extension.description%",
  "author": {
    "name": "Alejandro Daniel Di Stefano",
    "url": "https://armotusitio.com.ar"
  },
  "bugs": {
    "url": "https://armotusitio.com.ar/soporte/"
  },
  "homepage": "https://armotusitio.com.ar",
  "license": "MIT",
  "private": true,
  "preview": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%"
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%virtualWorkspace.description%"
    }
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "environment",
    "diagnostics",
    "troubleshooting",
    "node",
    "go",
    "ports",
    "local services"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:indizivo.control"
  ],
  "scripts": {
    "check": "node --check src/diagnostics.js && node --check src/port-owners.js && node --check src/versions.js && node --check src/comparison.js && node --check src/ui.js && node --check src/messages.js && node --check src/extension.js && node --check scripts/inspect-vsix.cjs",
    "test": "npm run build:types && node --test test/*.test.js",
    "verify": "npm run typecheck && npm run lint:types && npm run check && npm run lint:security && npm test",
    "package:vsix": "npx --no-install @vscode/vsce package --no-dependencies && npm run inspect:vsix",
    "package": "npm run verify && npm run package:vsix",
    "test:e2e": "npm run build:types && node test/e2e/run.js",
    "release:check": "npm run verify && npm run test:e2e && npm run test:vsix",
    "inspect:vsix": "node scripts/inspect-vsix.cjs",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rulesets:check": "node scripts/ruleset-governance.cjs",
    "test:vsix": "npm run package && npm run smoke:vsix",
    "benchmark": "npm run build:types && node scripts/benchmark.cjs",
    "lint:security": "node scripts/quality-gate.cjs",
    "test:coverage": "npm run build:types && node --experimental-test-coverage --test test/*.test.js",
    "test:coverage-gate": "npm run build:types && node scripts/coverage-gate.cjs",
    "smoke:vsix": "node test/vsix-e2e/run.js",
    "lint:types": "node scripts/lint-types.cjs",
    "prebuild:types": "node scripts/clean-types.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "5.8.3",
    "@types/node": "24.10.0",
    "@types/vscode": "1.99.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "indizivo.openHome",
        "title": "%command.openHome%",
        "category": "%command.category%"
      },
      {
        "command": "indizivo.diagnose",
        "title": "%command.diagnose%",
        "category": "%command.category%"
      },
      {
        "command": "indizivo.export",
        "title": "%command.export%",
        "category": "%command.category%"
      },
      {
        "command": "indizivo.cancel",
        "title": "%command.cancel%",
        "category": "%command.category%"
      },
      {
        "command": "indizivo.settings",
        "title": "%command.settings%",
        "category": "%command.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "indizivo",
          "title": "%views.container%",
          "icon": "media/indizivo-activity-bar.svg"
        }
      ]
    },
    "views": {
      "indizivo": [
        {
          "id": "indizivo.control",
          "name": "%views.control%",
          "type": "webview"
        }
      ]
    }
  },
  "icon": "media/indizivo-icon-128.png",
  "galleryBanner": {
    "color": "#18232F",
    "theme": "dark"
  }
}
