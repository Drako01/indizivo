[
 {"name":"express-explicit-port","files":{"package.json":"{\"name\":\"a\",\"scripts\":{\"start\":\"node server.js --port 4000\"},\"engines\":{\"node\":\">=18\"}}"},
  "expect":{"node":true,"go":false,"nodeRequirement":">=18","ports":[4000],"portOrigins":{"4000":"declared"}}},
 {"name":"next-default-port-is-heuristic","files":{"package.json":"{\"name\":\"b\",\"dependencies\":{\"next\":\"15.0.0\"}}"},
  "expect":{"node":true,"go":false,"ports":[3000],"portOrigins":{"3000":"heuristic"}}},
 {"name":"vite-default-port-is-heuristic","files":{"package.json":"{\"name\":\"c\",\"devDependencies\":{\"vite\":\"6.0.0\"}}"},
  "expect":{"node":true,"ports":[5173],"portOrigins":{"5173":"heuristic"}}},
 {"name":"plain-library-no-ports","files":{"package.json":"{\"name\":\"d\",\"main\":\"index.js\"}"},
  "expect":{"node":true,"ports":[]}},
 {"name":"go-minimum-only","files":{"go.mod":"module x\n\ngo 1.22\n"},
  "expect":{"go":true,"node":false,"goRequirement":"1.22","goToolchain":"","goRequirementOrigin":"declared"}},
 {"name":"go-with-toolchain","files":{"go.mod":"module x\n\ngo 1.22.0\n\ntoolchain go1.23.4\n"},
  "expect":{"go":true,"goRequirement":"1.22.0","goToolchain":"1.23.4","goToolchainOrigin":"declared"}},
 {"name":"go-implicit-version","files":{"go.mod":"module x\n"},
  "expect":{"go":true,"goRequirementOrigin":"implicit"}},
 {"name":"env-example-without-env-file","files":{"package.json":"{\"name\":\"e\"}",".env.example":"API_KEY=\nDB_URL=\n"},
  "expect":{"hasEnvExample":true,"hasEnvFile":false,"requiredEnv":["API_KEY","DB_URL"],"fileStates":{".env":"missing"}}},
 {"name":"env-keys-never-leak-values","files":{"package.json":"{\"name\":\"f\"}",".env.example":"TOKEN=\n",".env":"TOKEN=super-secret-value\n"},
  "expect":{"hasEnvFile":true,"missingEnv":[],"requiredEnv":["TOKEN"],"noText":"super-secret-value"}},
 {"name":"env-file-missing-key","files":{"package.json":"{\"name\":\"g\"}",".env.example":"A=\nB=\n",".env":"A=1\n"},
  "expect":{"missingEnv":["B"]}},
 {"name":"malformed-package-json","files":{"package.json":"{not json"},
  "expect":{"malformedPackage":true}},
 {"name":"pnpm-lockfile","files":{"package.json":"{\"name\":\"h\"}","pnpm-lock.yaml":"lockfileVersion: 9\n"},
  "expect":{"lockfiles":["pnpm-lock.yaml"]}},
 {"name":"ambiguous-lockfiles","files":{"package.json":"{\"name\":\"i\"}","pnpm-lock.yaml":"x","package-lock.json":"{}"},
  "expect":{"lockfilesCount":2}},
 {"name":"python-marker","files":{"pyproject.toml":"[project]\nname='p'\n"},
  "expect":{"node":false,"go":false,"optionalRuntime":"python"}},
 {"name":"empty-directory","files":{},
  "expect":{"node":false,"go":false,"ports":[]}}
]
